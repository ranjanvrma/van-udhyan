# Van Udyan Biodiversity Intelligence Platform Environment Configuration
PROJECT_NAME="Van Udyan Biodiversity Mapping"
ENVIRONMENT="development"
PORT=8000

# PostgreSQL + PostGIS Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/van_udyan_db"

# Pl@ntNet AI Identification API Key
# Register for a free API key at: https://my.plantnet.org/
PLANTNET_API_KEY=your_plantnet_api_key_here

# Pl@ntNet flora used for identification (default: Indian Subcontinent; "all" = world flora)
PLANTNET_PROJECT=k-indian-subcontinent

# RSWF NGO Administrative Password (for editing / deleting NGO records)
# Default development fallback: rswf-admin-pass
NGO_ADMIN_PASSWORD=rswf-admin-pass

# ---------------------------------------------------------------------------
# Cloud-deployment-only settings (leave empty for a local-only install)
# See docs/DEPLOYMENT.md for the full walkthrough.
# ---------------------------------------------------------------------------

# Supabase Storage for uploaded photos — otherwise photos vanish on redeploy
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role secret, keep private>
# SUPABASE_BUCKET=van-udyan-photos

# Mirror NGO stores (observations, planted plants, visits) to Postgres so they survive redeploys.
# Default OFF so local dev / tests never push data into (or pull data from) the DB.
# ENABLE_STATE_SYNC=true

# Comma-separated list of deployed frontend origins allowed to call this API
# CORS_ORIGINS=https://van-udyan-dashboard.onrender.com
